# Modo de execução: "desktop" (padrão local no Windows) ou "web" (nuvem / Railway)
FRYIVS_MODE=desktop
# Pasta persistente de dados em nuvem (ex.: /data no volume do Railway)
# FRYIVS_DATA_DIR=/data

LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=small
TTS_PROVIDER=edge
EDGE_TTS_VOICE=fr-FR-VivienneMultilingualNeural
EDGE_TTS_VOICE_EN=fr-FR-VivienneMultilingualNeural
EDGE_TTS_RATE=+4%
EDGE_TTS_PITCH=+0Hz
CLAP_WAKE_ENABLED=true
CLAP_SENSITIVITY=media
OPENAI_API_KEY=sua_openai_api_key_aqui
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1
WAKE_WORD_ENABLED=true
WAKE_WORD_MODEL=base
WAKE_WORD_THRESHOLD=0.80
OPENWAKEWORD_THRESHOLD=0.55
OPENWAKEWORD_VAD_THRESHOLD=0.40
VOICE_LOCAL_PLAYBACK=true

# =============================================================================
# Segurança E2EE (Bloqueio Criptografado de Voz, Chat, Skills e WebSocket)
# =============================================================================
# Exige desbloqueio via handshake ECDH P-256 + HKDF-SHA256 + AES-256-GCM antes
# que a F.R.Y.I.Vs possa falar (TTS/VoiceDaemon) ou responder (Chat/API/WS).
FRYIVS_REQUIRE_E2EE_PASSWORD=true
# Configure a senha em texto (será convertida para PBKDF2-HMAC-SHA256 310k iter em memória)
# OU preferencialmente gere um hash com: python -m core.e2ee_auth
FRYIVS_VOICE_PASSWORD=defina_sua_senha_forte_aqui
# FRYIVS_VOICE_PASSWORD_HASH=pbkdf2_sha256$310000$<salt_b64>$<dk_b64>
FRYIVS_E2EE_MAX_ATTEMPTS=5
FRYIVS_E2EE_LOCKOUT_SECONDS=120
FRYIVS_E2EE_SESSION_TTL=28800

# =============================================================================
# Automação Corporativa n8n (HMAC-SHA256 + SSRF Guard + REST API v1)
# =============================================================================
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=sua_n8n_api_key_aqui
N8N_HMAC_SECRET=defina_um_segredo_hmac_forte_para_n8n

# =============================================================================
# Orquestrador Multi-Agente Hermes (WSL2 + Budget Guard + Callbacks HMAC)
# =============================================================================
HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=sua_hermes_api_key_aqui
HERMES_HMAC_SECRET=defina_um_segredo_hmac_forte_para_hermes
