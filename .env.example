# Configurações do F.R.Y.I.Vs (Sistema Fronteira de Inteligência Virtual)

# Provedor Principal de LLM (gemini | hybrid | ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest

# Motor Secundário / Local (Ollama)
OLLAMA_MODEL=llama3.2

# Whisper STT (small | base | tiny | medium | large-v3)
WHISPER_MODEL=small

# TTS Provider (edge | openai | voicestudio | auto)
# voicestudio = usa o VoiceStudio (OmniVoice) local com clonagem de voz e 646+ idiomas
TTS_PROVIDER=edge

# OpenAI TTS (caso use provider openai)
OPENAI_API_KEY=sua_openai_api_key_aqui
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1

# VoiceStudio TTS (caso use provider voicestudio)
# URL local do backend VoiceStudio (auto-detectado se omitido)
# VOICESTUDIO_URL=http://127.0.0.1:8000
# VOICESTUDIO_VOICE=default
# VOICESTUDIO_MODEL=omnivoice

# Wake Word & Modo Supercomputador ("FRYIVS / Fraives / Frives") via openWakeWord (ONNX)
WAKE_WORD_ENABLED=true
WAKE_WORD_MODEL=base
WAKE_WORD_THRESHOLD=0.80
OPENWAKEWORD_THRESHOLD=0.55
OPENWAKEWORD_VAD_THRESHOLD=0.40
VOICE_LOCAL_PLAYBACK=true



